FROM rust:1.99.1-bookworm@sha256:e6f2cff35d0f309acf8433b4f05878ed77092602c5065cc81801177da0bb3a9c AS build
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends cmake clang && rm -rf /var/lib/apt/lists/*
COPY backend backend
RUN cargo build --release --locked --manifest-path backend/Cargo.toml

FROM debian:bookworm-slim@sha256:e67eeead736ff7bbe258ef088bff683635c561b1fcfefad0806c1df4ab49ce0e
LABEL org.opencontainers.image.source=https://github.com/ModernsDev/realopensnow
COPY --from=build /app/backend/target/release/realopensnow /usr/local/bin/realopensnow
USER 10010:10010
ENTRYPOINT ["/usr/local/bin/realopensnow"]
