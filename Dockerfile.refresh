FROM node:24-slim@sha256:873f586f3794f52281bd039bf02c048a0be08fde619338f9941bad1eb6b34530
LABEL org.opencontainers.image.source=https://github.com/ModernsDev/realopensnow
WORKDIR /app
COPY package.json wrangler.jsonc ./
COPY src src
COPY worker worker
COPY scripts/refresh-forecasts.mjs scripts/
USER node
CMD ["node", "scripts/refresh-forecasts.mjs"]
