{
  "name": "realopensnow",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "node --test tests/*.test.ts",
    "build:site": "VITE_HOSTED_FORECAST=1 npm run build && node scripts/build-site.mjs",
    "deploy": "npm run build:site && wrangler d1 migrations apply DB --remote && wrangler deploy",
    "deploy:check": "npm run build:site && wrangler deploy --dry-run"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "leaflet": "^1.9.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "wrangler": "4.138.0"
  }
}
